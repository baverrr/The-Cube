# Whitespace basics only, matching the existing code. No C# style rules, so nothing needs reformatting.
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,xaml}]
charset = utf-8

[*.{csproj,props,targets,slnx,xml,manifest}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false # a trailing double space is a line break
